# 可直接在应用「设置」中输入密钥（只保留在服务内存中）。
# 如需重启后继续使用，可复制本文件为 .env，再在本机填写。
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 北京；新加坡可使用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 也可使用百炼控制台提供的 workspace 专属地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_ASR_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
QWEN_TEXT_MODEL=qwen-plus
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_SPEECH_MODEL=qwen3-tts-flash
PORT=4318
HOST=127.0.0.1
# 手机接入需可信 HTTPS 和访问密码；详见 README。
# HOST=0.0.0.0
# ACCESS_TOKEN=请设置足够长的访问密码
# PUBLIC_ORIGIN=https://你的电脑局域网地址:4318
# TLS_CERT=certs/server.pem
# TLS_KEY=certs/server-key.pem
